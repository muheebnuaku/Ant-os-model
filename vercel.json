{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{packages/antos-core/src/**,services/api/src/**,services/api/migrations/**,services/api/alembic.ini,profiles/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/v1/ops/daily", "schedule": "5 0 * * *" }]
}
