{
  "realm": "antos",
  "displayName": "ANT-OS Ω / AFRICA-OS Ω",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(5)",
  "otpPolicyType": "totp",
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 10 },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30 }
  ],
  "roles": {
    "realm": [
      { "name": "citizen_observer", "description": "Public-facing view of non-sensitive sector outputs." },
      { "name": "entrepreneur", "description": "MSMEs, startups, cooperatives, and individual business operators." },
      { "name": "university_researcher", "description": "Academic and research institution actors." },
      { "name": "operator", "description": "Field-level staff submitting operational signals." },
      { "name": "analyst", "description": "Institutional analysts generating reports and sector intelligence." },
      { "name": "sector_lead", "description": "Sector-level decision authority." },
      { "name": "regulator", "description": "National regulatory authority with compliance and audit powers." },
      { "name": "administrator", "description": "System configuration and role management authority." },
      { "name": "developer", "description": "Technical integration and runtime configuration authority." },
      { "name": "sovereign_admin", "description": "National or AU-level sovereign governance authority." }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"nation_id\",\"displayName\":\"Nation (ISO 3166-1 alpha-2)\",\"validations\":{\"pattern\":{\"pattern\":\"^[A-Z]{2}$\",\"error-message\":\"Use a two-letter country code, e.g. GH\"}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "antos-api-access",
      "description": "Adds the antos-api audience and the caller's nation to access tokens.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "antos-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "antos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "nation_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "nation_id",
            "claim.name": "nation_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "antos-api",
      "name": "ANT-OS Ω API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "antos-web",
      "name": "ANT-OS Ω web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:3000/*" },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "basic", "antos-api-access"]
    }
  ]
}
