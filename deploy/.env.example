# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=

# Step 14 model gateway. "none" = deterministic rule-based recommender only.
ANTOS_CLOUD_PROVIDER=none
# ANTOS_CLOUD_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTOS_ANTHROPIC_MODEL=claude-opus-5-5
# ANTOS_ANTHROPIC_EFFORT=medium

# Sovereign on-prem model (OpenAI-compatible: vLLM, Ollama). Required for
# packs with model_route: sovereign (health, finance, governance) to use a model.
# ANTOS_SOVEREIGN_BASE_URL=http://vllm:8000/v1
# ANTOS_SOVEREIGN_MODEL=
# ANTOS_SOVEREIGN_API_KEY=

# Notifications (escalation opened / SLA breached / audit anchored).
# Unset = logged only. The receiver checks X-Antos-Signature (HMAC-SHA256).
# ANTOS_NOTIFY_WEBHOOK_URL=
# ANTOS_NOTIFY_WEBHOOK_SECRET=

# Signed audit anchors. Create a key with:
#   python -m antos_api.cli generate-anchor-key /keys
# ANTOS_NODE_ID=gh-pilot-1
# ANTOS_ANCHOR_PRIVATE_KEY_PATH=/keys/anchor_ed25519.pem

# Rate limits (per caller, per minute). Use "redis" with more than one API process.
# ANTOS_RATE_LIMIT_BACKEND=memory
# ANTOS_RATE_LIMIT_PER_MINUTE=600
# ANTOS_RATE_LIMIT_DECISIONS_PER_MINUTE=60

# Keycloak admin (only with --profile identity).
# KEYCLOAK_ADMIN_PASSWORD=

# Keycloak (OIDC). Leave unset to accept API keys only.
# ANTOS_OIDC_ISSUER=https://id.example.gov.gh/realms/antos
# ANTOS_OIDC_AUDIENCE=antos-api
# ANTOS_OIDC_JWKS_URL=https://id.example.gov.gh/realms/antos/protocol/openid-connect/certs
